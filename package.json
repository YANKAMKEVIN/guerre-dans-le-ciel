{
  "name": "guerre-dans-le-ciel",
  "private": true,
  "version": "2.0.0",
  "description": "Combat aérien three.js dans le navigateur : un ange contre trois vagues de démons puis le Dragon à sept têtes.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot": "vitest run --config vitest.bot.config.ts",
    "e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm test && npm run bot && npm run build"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "@types/three": "0.160.0",
    "eslint": "9.39.1",
    "globals": "16.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
